# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Transactional booking email (server only)
EMAIL_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Optional notification worker; never expose these values to the browser
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optional custom SMTP for Supabase Auth (configure these in Supabase Dashboard, not Render)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=
